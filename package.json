{
  "name": "kimlalman28-portfolio",
  "version": "1.0.0",
  "description": "Portfolio website for Kimberly Lalmansingh",
  "main": "index.html",
  "scripts": {
    "test": "npm run test:html && npm run test:a11y && npm run test:e2e",
    "test:html": "html-validator --file=index.html --verbose",
    "test:a11y": "start-server-and-test serve http://localhost:8000 'pa11y-ci'",
    "test:links": "linkinator index.html --recurse",
    "test:lighthouse": "start-server-and-test serve http://localhost:8000 'lhci autorun'",
    "test:e2e": "playwright test",
    "serve": "http-server . -p 8000 --silent"
  },
  "keywords": [
    "portfolio",
    "static-site"
  ],
  "author": "Kimberly Lalmansingh",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.8.3",
    "@lhci/cli": "^0.13.0",
    "@playwright/test": "^1.40.1",
    "html-validator-cli": "^8.1.0",
    "http-server": "^14.1.1",
    "linkinator": "^6.0.4",
    "pa11y-ci": "^3.1.0",
    "start-server-and-test": "^2.0.3"
  }
}
