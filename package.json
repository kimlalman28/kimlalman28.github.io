{
  "name": "portfolio-website",
  "version": "1.0.0",
  "description": "Personal portfolio website with comprehensive testing",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:accessibility": "playwright test tests/accessibility.spec.js",
    "test:visual": "playwright test tests/visual-regression.spec.js",
    "lint:html": "htmlhint index.html",
    "lint:css": "stylelint '**/*.css'",
    "lighthouse": "lighthouse http://localhost:8000 --view",
    "serve": "python3 -m http.server 8000"
  },
  "keywords": [
    "portfolio",
    "website",
    "testing"
  ],
  "author": "Kimberly Lalman Singh",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "axe-playwright": "^1.2.3",
    "htmlhint": "^1.1.4",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0",
    "lighthouse": "^11.4.0"
  }
}
